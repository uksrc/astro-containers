Bootstrap: docker
From: ubuntu:24.04

%labels
    APPLICATION_NAME Ubuntu LTS + DP3
    APPLICATION_VERSION 6.6
    OS_VERSION Ubuntu 24.04
    APPLICATION_URL https://git.astron.nl/RD/DP3

    SYSTEM_NAME slurm.cam.uksrc.org
    SYSTEM_APPTAINER_VERSION 1.4.5
    SYSTEM_URL https://www.uksrc.org

    AUTHOR_NAME ASTRON / Johannes Allotey
    AUTHOR_EMAIL uksrc-support@manchester.ac.uk
    
%environment
    export DEBIAN_FRONTEND=noninteractive

    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    export EVERYBEAM_DATADIR=/usr/share/everybeam
    export PATH=/dp3env/bin:$PATH
    export PYTHONPATH=/usr/lib:/usr/lib/python3.12/site-packages:$PYTHONPATH

%post
    export DP3_VERSION=v6.6
    export EVERYBEAM_VERSION=""
    export IDG_VERSION=""
    export AOFLAGGER_VERSION=""
    export SAGECAL_VERSION=v0.8.6
    export WSCLEAN_VERSION=""
    export CASACORE_VERSION=v3.8.1

    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y \
        build-essential \
        cmake \
        ninja-build \
        git \
        wget \
	curl \
        pkg-config \
        g++ \
        gfortran \
        flex \
        bison \
        python3-full \
        python3-dev \
        python3-venv \
        libboost-filesystem-dev \
        libboost-program-options-dev \
        libboost-python-dev \
        libboost-test-dev \
        libarmadillo-dev \
        libcfitsio-dev \
        libfftw3-dev \
        libgsl-dev \
        libhdf5-serial-dev \
        libgtkmm-4.0-dev \
        liblua5.3-dev \
        libpng-dev \
        wcslib-dev \
        pybind11-dev \
	openmpi-bin \
	libopenmpi-dev

    rm -rf /var/lib/apt/lists/*

    python3 -m venv /dp3env

    /dp3env/bin/pip install \
        numpy \
        scipy \
        h5py \
        astropy \
	ipython \
        pytest

    # Casacore data
    mkdir -p /usr/share/casacore/data
    cd /usr/share/casacore/data
    #wget https://www.astron.nl/iers/WSRT_Measures.ztar #gets stuck for a long time
    curl -O ftp://ftp.astron.nl/outgoing/Measures/WSRT_Measures.ztar
    tar xfz WSRT_Measures.ztar
    rm WSRT_Measures.ztar

    # Casacore
    cd /root 
    git clone https://github.com/casacore/casacore.git
    cd casacore
    git checkout ${CASACORE_VERSION}
    mkdir build
    cd build
    cmake .. \
      -DCMAKE_INSTALL_PREFIX=/usr/local \
      -DPython3_EXECUTABLE=/dp3env/bin/python3 \
      -DDATA_DIR=/usr/share/casacore/data \
      -DUSE_OPENMP=ON \
      -DUSE_THREADS=ON \
      -DUSE_HDF5=ON \
      -DUSE_MPI=ON \
      -DBUILD_SISCO=ON
    make -j$(nproc)
    make install
    cd /
    rm -rf /root/casacore

    # python-casacore
    git clone https://github.com/casacore/python-casacore.git /root/python-casacore
    cd /root/python-casacore
    /dp3env/bin/pip install .
    cd /
    rm -rf /root/python-casacore

    # AOFlagger
    git clone https://gitlab.com/aroffringa/aoflagger.git /root/aoflagger
    cd /root/aoflagger
    git checkout ${AOFLAGGER_VERSION}
    mkdir build
    cd build
    cmake .. \
      -G Ninja \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DENABLE_GUI=ON
    ninja install
    cd /
    rm -rf /root/aoflagger

    # IDG
    git clone https://git.astron.nl/RD/idg.git /root/idg
    cd /root/idg
    git checkout ${IDG_VERSION}
    mkdir build
    cd build
    cmake .. \
      -G Ninja \
      -DCMAKE_INSTALL_PREFIX=/usr
    ninja install
    cd /
    rm -rf /root/idg

    # EveryBeam
    git clone https://git.astron.nl/RD/EveryBeam.git /root/everybeam
    cd /root/everybeam
    git checkout ${EVERYBEAM_VERSION}
    mkdir build
    cd build
    cmake .. \
      -G Ninja \
      -DCMAKE_INSTALL_PREFIX=/usr
    ninja install
    cd /
    rm -rf /root/everybeam

    # SAGECal libdirac
    git clone https://github.com/nlesc-dirac/sagecal.git /root/sagecal
    cd /root/sagecal
    git checkout ${SAGECAL_VERSION}
    mkdir build
    cd build
    cmake .. \
      -G Ninja \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DLIB_ONLY=ON
    ninja install
    cd /
    rm -rf /root/sagecal

    # WSClean
    git clone https://gitlab.com/aroffringa/wsclean.git /root/wsclean
    cd /root/wsclean
    git checkout ${WSCLEAN_VERSION}
    mkdir build
    cd build
    cmake .. \
      -G Ninja \
      -DCMAKE_INSTALL_PREFIX=/usr
    ninja install
    cd /
    rm -rf /root/wsclean

    # DP3
    git clone https://git.astron.nl/RD/DP3.git /root/dp3
    cd /root/dp3
    git checkout ${DP3_VERSION}
    mkdir build
    cd build
    cmake .. \
      -G Ninja \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DBUILD_TESTING=OFF \
      -DPython3_EXECUTABLE=/dp3env/bin/python3
    ninja install
    cd /
    rm -rf /root/dp3
    
    ldconfig

%test
    DP3 --version
    wsclean --version
    aoflagger --version 
    python3 -c "import casacore.tables"
    python3 -c "import everybeam"
    python3 -c "import dp3"
    python3 -c "import aoflagger"

%runscript
    exec /bin/bash