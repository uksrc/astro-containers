Bootstrap: docker
From: ubuntu:24.04

%labels
    APPLICATION_NAME Ubuntu LTS + AOFlagger 
    APPLICATION_VERSION 3.5
    OS_VERSION Ubuntu 24.04
    APPLICATION_URL https://gitlab.com/aroffringa/aoflagger

    SYSTEM_NAME slurm.cam.uksrc.org
    SYSTEM_APPTAINER_VERSION 1.4.5
    SYSTEM_URL https://www.uksrc.org

    AUTHOR_NAME Johannes Allotey
    AUTHOR_EMAIL uksrc-support@manchester.ac.uk

%environment
    export PIP_ROOT_USER_ACTION=ignore
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONPATH=$PYTHONPATH:/usr/local/lib
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

%post
    set -e

    # Installing system dependencies
    apt-get update
    apt-get install -y software-properties-common
    add-apt-repository universe
    apt-get update

    apt-get install -y git wget cmake build-essential gfortran g++
    apt-get install -y libncurses-dev libncursesw6 libreadline-dev
    apt-get install -y flex bison pkg-config evince eog 
    apt-get install -y libblas-dev liblapack-dev python3-setuptools python3-pip libpython3-dev python3-dev pybind11-dev

apt-get install -y libboost-all-dev libboost-date-time-dev libboost-test-dev
    apt-get install -y libcfitsio-dev wcslib-dev libfftw3-dev libgsl-dev libhdf5-dev libhdf5-serial-dev
    apt-get install -y libhdf5-openmpi-dev libhdf5-openmpi-hl-cpp-100t64 libhdf5-mpich-hl-cpp-100t64 libhdf5-hl-cpp-100t64
    apt-get install -y  libadios2-common-core-dev libadios2-serial-c-dev libadios2-common-c++11-dev
    apt-get install -y libcunit1-dev libunwind-dev libopenmpi-dev openmpi-bin zlib1g-dev libzmq3-dev

    apt-get install -y libfabric-dev libucx-dev libsqlite3-dev 
    apt-get install -y libgtkmm-4.0-dev libglibmm-2.4-dev libpangomm-1.4-dev libatkmm-1.6-dev libcairomm-1.0-dev
    apt-get install -y libsigc++-2.0-dev liblua5.3-dev libpng-dev libxml2-dev libx11-dev python3-numpy

    # Install IPython and jupyterlab
    pip install --break-system-packages ipython jupyterlab mpi4py 

    # Build ADIOS2
    cd /root
    git clone https://github.com/ornladios/ADIOS2.git
    cd ADIOS2
    mkdir -p build && cd build
    cmake .. -DADIOS2_USE_MPI=ON -DCMAKE_INSTALL_PREFIX=/usr/local
    make -j20
    make install
    ldconfig

    # Update casacore Measures data
    cd /root 
    mkdir -p /usr/local/share/casacore/data
    cd /usr/local/share/casacore/data
    wget -q https://www.astron.nl/iers/WSRT_Measures.ztar
    tar -xzvf WSRT_Measures.ztar
    rm WSRT_Measures.ztar

    # Build casacore
    cd /root
    git clone --recurse-submodules https://github.com/casacore/casacore.git
    cd casacore
    mkdir -p build && cd build
    cmake .. \
        -DCMAKE_INSTALL_PREFIX=/usr/local/casacore \
        -DDATA_DIR=/usr/local/share/casacore/data \
        -DBoost_NO_BOOST_CMAKE=True \
        -DUSE_OPENMP=ON \
	-DUSE_MPI=ON \
        -DUSE_HDF5=ON \
        -DBUILD_PYTHON3=ON \
	-DPYTHON_EXECUTABLE=$(which python3) \
        -DUSE_THREADS=ON \
	-DUSE_STACKTRACE=ON \
	-DADIOS2_DIR=/usr/local
    make -j20
    make install

    # Build aoflagger
    cd /root
    git clone --recurse-submodules https://gitlab.com/aroffringa/aoflagger.git
    cd aoflagger
    mkdir build && cd build
    cmake .. \
        -DCASACORE_ROOT_DIR=/usr/local/casacore \
        -DBUILD_SHARED_LIBS=ON \
        -DENABLE_GUI=ON \
	-DPKG_CONFIG_EXECUTABLE=/usr/bin/pkg-config
    make -j20
    make install

    # Clean up build artefacts
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    rm -rf /root/*

%runscript
    echo "aoflagger container ready"
    exec "$@"
