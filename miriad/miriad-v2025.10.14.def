Bootstrap: docker
From: ubuntu:22.04

%labels
    APPLICATION_NAME Ubuntu + Miriad
    APPLICATION_URL https://www.atnf.csiro.au/computing/software/miriad/
    APPLICATION_VERSION 2025.10.14
    OS_VERSION 22.04
    SYSTEM_NAME slurm.cam.uksrc.org
    SYSTEM_APPTAINER_VERSION 1.4.2
    SYSTEM_URL https://www.uksrc.org
    AUTHOR_NAME Jack Radcliffe / originally from ilifu
    AUTHOR_EMAIL uksrc-support@manchester.ac.uk

%environment
    export LC_ALL=C
    export MIR=/usr/local/miriad
    export MIRPDOC=$MIR/doc
    export PATH=$PATH:/usr/local/miriad/linux64/bin
    # Ensure exec sessions pick up full MIRIAD environment.
    if [ -f /usr/local/miriad/MIRRC.sh ]; then
        . /usr/local/miriad/MIRRC.sh
    fi

%help
    Miriad is installed from binary distribution at /usr/local/miriad/linux64.
    Environment variables are automatically set when container starts.
    Run 'miriad' to enter the MIRIAD environment, then use commands like:
    - inp atlod: show parameters for atlod task
    - tasklist: list available tasks
    - help <taskname>: get help on specific task

%post
    ##############################################################################
    # Setting up Environment
    # Create Installation Directories and export paths. This is needed as part of post.
    # %environment scriptlet does not define these paths during %post only after.
    export MIR=/usr/local/miriad

    export DEBIAN_FRONTEND=noninteractive

    # Fix command prompt in Singularity
    printf 'export PS1="\u@$SINGULARITY_NAME:\w$ "' > /.singularity.d/env/999-psvars.sh
    ###############################################################################

    # Update and install base packages
    apt-get update -y
    apt-get install -y software-properties-common wget vim apt-utils git build-essential \
        bzip2 ca-certificates locales

    # Set locale
    locale-gen en_US.UTF-8
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

    # Install Miriad requirements
    apt-get install -y libpng-dev zlib1g-dev libreadline-dev \
        libxaw7-dev libxmu-dev libxext-dev libxt-dev libxpm-dev \
        libsm-dev libice-dev libfftw3-dev\
        gfortran xorg-dev libreadline6-dev \

    # Create installation directory
    mkdir -p /usr/local
    cd /usr/local

    # Download and install Miriad
    wget https://github.com/csiro/miriad/releases/download/2025.10.14/Miriad-2025.10.14-Linux-x86_64.tar.gz
    #wget -q ftp://ftp.atnf.csiro.au/pub/software/miriad/miriad-linux64.tar.bz2
    
    # Extract with proper permissions
    tar -xvf Miriad-2025.10.14-Linux-x86_64.tar.gz
    mv Miriad-2025.10.14-Linux-x86_64/miriad .
    rm -r Miriad-2025.10.14-Linux-x86_64
    
    # Set up MIRIAD configuration
    cd /usr/local/miriad
    sed -e "s,@MIRROOT@,/usr/local/miriad," scripts/MIRRC.in > MIRRC
    sed -e "s,@MIRROOT@,/usr/local/miriad," scripts/MIRRC.sh.in > MIRRC.sh
    chmod 644 MIRRC*

    # Clean up
    rm -f /usr/local/Miriad-2025.10.14-Linux-x86_64.tar.gz
    apt-get clean
    apt-get autoremove -y
    rm -rf /var/lib/apt/lists/*

%runscript
    # Source the MIRIAD environment and start bash
    source /usr/local/miriad/MIRRC.sh
    exec /bin/bash "$@"
