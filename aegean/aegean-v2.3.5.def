Bootstrap: docker
From: ubuntu:22.04

%labels
    APPLICATION_NAME Ubuntu LTS + Aegean 
    APPLICATION_VERSION 2.3.5
    OS_VERSION Ubuntu 22.04
    APPLICATION_URL https://github.com/PaulHancock/Aegean

    SYSTEM_NAME slurm.cam.uksrc.org
    SYSTEM_APPTAINER_VERSION 1.4.5
    SYSTEM_URL https://www.uksrc.org

    AUTHOR_NAME Johannes Allotey
    AUTHOR_EMAIL uksrc-support@manchester.ac.uk

%environment
    export PIP_ROOT_USER_ACTION=ignore
    export DEBIAN_FRONTEND=noninteractive
    export PATH=/usr/local/bin:$PATH

%post
    apt-get update && apt-get install -y \
        pkg-config \
        build-essential \
        wget \
        git \
        cmake \
        gfortran \
        g++ \
        pybind11-dev \
        python3-setuptools \
        python3-pip \
        wcslib-dev \
        libblas-dev \
        libboost-date-time-dev \
        libboost-filesystem-dev \
        libboost-program-options-dev \
        libboost-system-dev \
        libboost-all-dev \
        libcfitsio-dev \
        libfftw3-dev \
        libgsl-dev \
        libhdf5-dev \
        liblapack-dev \
        libopenmpi-dev \
        libpython3-dev \
        libxml2-dev

    # Install pip from PyPA
    wget -q https://bootstrap.pypa.io/get-pip.py
    python3 get-pip.py

    # Install Python dependencies
    pip install --no-cache-dir \
        ipython \
        numpy \
        scipy \
        tqdm \
        astropy \
        healpy \
        lmfit \
        scikit-learn \
        configargparse \
        matplotlib \
        numba \
        mpi4py \
        impi-rt \
        mpich \
        openmpi

    # Install Aegean
    pip install --no-cache-dir AegeanTools[faster]

    # Cleanup
    apt-get clean
    rm -rf /var/lib/apt/lists/* get-pip.py

%runscript
    exec "$@"

%help
    MPI-enabled AegeanTools container.

    Example usage:
        mpirun apptainer exec aegean.sif aegean --help

    Designed for Slurm environments:
        srun aegean
        mpirun aegean
        mpiexec aegean