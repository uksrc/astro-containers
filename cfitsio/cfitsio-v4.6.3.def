Bootstrap: docker
From: ubuntu:22.04

%labels
    APPLICATION_NAME Ubuntu LTS + cfitsio
    APPLICATION_VERSION 4.6.3
    OS_VERSION Ubuntu 22.04
    APPLICATION_URL https://github.com/HEASARC/cfitsio

    SYSTEM_NAME slurm.cam.uksrc.org
    SYSTEM_APPTAINER_VERSION 1.4.5
    SYSTEM_URL https://www.uksrc.org

    AUTHOR_NAME Johannes Allotey
    AUTHOR_EMAIL uksrc-support@manchester.ac.uk

%environment
    export DEBIAN_FRONTEND=noninteractive

%post
    apt-get update && apt-get install -y \
        git \
        curl \
        libcurl4-openssl-dev \
        zlib1g-dev \
        libglobus-gsi-cert-utils-dev \
        libglobus-gsi-openssl-error-dev \
        bzip2 \
        lbzip2 \
        libbz2-dev \
        build-essential \
        cmake \
        gfortran \
        libcfitsio-dev \
        g++ 

    # Clone and build cfitsio
    git clone --recurse-submodules https://github.com/HEASARC/cfitsio.git
    cd cfitsio
    mkdir build && cd build
    cmake .. \
        -DBUILD_SHARED_LIBS=ON \
        -DUSE_CURL=ON \
        -DUSE_PTHREADS=ON \
        -DITERPROGS=ON \
        -DTESTS=ON \
        -DUTILS=ON \
        -DUSE_BZIP2=ON \
        -DUSE_SSSE3=ON
    cmake --build . --parallel
    cmake --install .
    ldconfig

    # Copy the test scripts across so they can be 
    # called in the same way as fitscopy etc
    cp /cfitsio/build/Iter_Image /usr/local/bin/
    cp /cfitsio/build/Iter_Var /usr/local/bin/
    cp /cfitsio/build/TestProg /usr/local/bin/

    # Clean-up
    apt-get clean
    rm -rf /var/lib/apt/lists/* 

%runscript
    echo "Container is ready"
    exec "$@"

%help
   CFITSIO is a library of reading, writing, and manipulating FITS files. 
   The following functionalities are available:
   - fitscopy
   - fitsverify
   - fpack
   - funpack
   - imcopy
   - speed
   - smem

  The test functionalities are also available if interested. These are 
  TestProg, Iter_Image and Iter_Var. 


