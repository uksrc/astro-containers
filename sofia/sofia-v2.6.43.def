Bootstrap: docker
From: ubuntu:22.04

%labels
    APPLICATION_NAME Ubuntu LTS + SoFiA-2 + BusyFit + sofia-gui + SoFiA Image Pipeline + Deblend detections + OptiFind + SpecPlot
    APPLICATION_VERSION 2.6.55
    OS_VERSION Ubuntu 22.04
    APPLICATION_URL https://gitlab.com/SoFiA-Admin/SoFiA-2

    SYSTEM_NAME slurm.cam.uksrc.org
    SYSTEM_APPTAINER_VERSION 1.4.5
    SYSTEM_URL https://www.uksrc.org
    
    AUTHOR_NAME Johannes Allotey 
    AUTHOR_EMAIL uksrc-support@manchester.ac.uk

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PIP_ROOT_USER_ACTION=ignore
    export PATH="/opt/miniconda/bin:$PATH"

    # MPI best practices
    export OMPI_MCA_btl="^openib"
    export OMPI_MCA_pml="ucx"
    export OMPI_MCA_osc="ucx"

%post
    set -e

    echo "=== Base system ==="
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y \
        wget \
        git \
        make \
        cmake \
        procps \
        g++ \
        gfortran \
        build-essential \
        pkg-config \
        python3-dev \
        libpython3-dev \
        python3-astropy \
        python3-matplotlib \
        python3-setuptools \
        libgsl-dev \
	libopenmpi-dev \
	libhdf5-openmpi-dev \
        libjpeg-dev \
        libpng-dev \
        wcslib-dev \
        gnuplot \
        ghostscript \
        x11-utils \
        eog \
        qt5-qmake-bin qt5-qmake qtbase5-dev libqt5xml5 \
        libqt5gamepad5-dev \
        libgl1-mesa-dev \
        php-dev \
        imagemagick \
        pybind11-dev 

    apt-get install --reinstall -y libxcb-xinerama0
    rm -rf /var/lib/apt/lists/*

    echo "=== Miniconda (Python 3.11) ==="
    mkdir -p /opt/conda
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-py311_25.9.1-3-Linux-x86_64.sh \
        -O /opt/conda/miniconda.sh
    bash /opt/conda/miniconda.sh -b -p /opt/miniconda
    export PATH="/opt/miniconda/bin:$PATH"

    wget -q https://bootstrap.pypa.io/get-pip.py
    python3 get-pip.py
    #pip install wheel
    rm get-pip.py

    # Upgrade pip first (recommended)
    pip install --upgrade pip setuptools wheel
    pip install ipython 

    # SoFiA-2 (with MPI and HDF5 support) 
    git clone --recurse-submodules https://gitlab.com/SoFiA-Admin/SoFiA-2.git
    cd SoFiA-2
    make install -j$(nproc) \
    	 OMP=true \
    	 HDF5=true \
    	 CC=mpicc \
    	 CFLAGS="-I/usr/include/hdf5/openmpi -I/usr/include/wcslib" \
    	 LDFLAGS="-L/usr/lib/x86_64-linux-gnu -lhdf5_openmpi -lwcs -lm -fopenmp"
	 
    # BusyFit
    git clone --recurse-submodules https://gitlab.com/SoFiA-Admin/BusyFit.git
    cd BusyFit
    chmod 764 compile.sh
    ./compile.sh
    cp busyfit /opt/miniconda/bin/
    cd /

    # sofia-gui
    git clone --recurse-submodules https://gitlab.com/SoFiA-Admin/sofia-gui.git
    cd sofia-gui
    qmake -qt=qt5
    make -j$(nproc)
    make clean
    cp sofia-gui /opt/miniconda/bin/
    cd /

    # SoFiA Image Pipeline
    git clone --recurse-submodules https://github.com/kmhess/SoFiA-image-pipeline.git
    cd SoFiA-image-pipeline
    pip install .
    cd /

    # Deblend detections
    git clone --recurse-submodules https://github.com/PeterKamphuis/deblend_sofia_detections.git
    cd deblend_sofia_detections
    pip install .
    cd /

    # OptiFind
    git clone --recurse-submodules https://gitlab.com/SoFiA-Admin/OptiFind
    ln -sf /usr/bin/python3 /usr/bin/python
    chmod +x OptiFind/optifind.py
    cp OptiFind/optifind.py /opt/miniconda/bin/

    # SpecPlot
    git clone --recurse-submodules https://gitlab.com/SoFiA-Admin/SpecPlot.git
    chmod +x SpecPlot/SpecPlot.py
    cp SpecPlot/SpecPlot.py /opt/miniconda/bin/

    rm -rf /root/* 

%runscript
    exec "$@"

%help
    MPI-enabled SoFiA-2 container with HDF5 support.
    BusyFit, sofia-gui, SoFiA-image-pipeline,
    deblend_sofia_detections, optifind, and SpecPlot
    are provided too.

    Use host MPI via:
        mpirun apptainer exec sofia.sif sofia

    Works with:
        srun
        mpirun
        mpiexec
